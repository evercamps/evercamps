{
  "type": "object",
  "properties": {
    "attribute_group_id": {
      "type": ["string", "integer"],
      "pattern": "^[1-9][0-9]*$"
    },
    "attribute_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "url_key": {
      "type": "string",
      "pattern": "^\\S+$",
      "errorMessage": {
        "pattern": "Url key should not contain spaces"
      }
    },
    "description": {
      "type": "string",
      "skipEscape": true
    },
    "short_description": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string",
      "skipEscape": true
    },
    "meta_keywords": {
      "type": "string"
    },
    "default_variant_id": {
      "type": ["string", "integer"],
      "pattern": "^[1-9][0-9]*$"
    }
  },
  "required": ["attribute_group_id", "attribute_codes"],
  "additionalProperties": true
}
